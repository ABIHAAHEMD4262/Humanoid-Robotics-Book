{
  "name": "auth-backend",
  "version": "1.0.0",
  "description": "Authentication and personalization backend for Humanoid Robotics Book",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=../.env server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node -r dotenv/config dist/server.js dotenv_config_path=../.env",
    "migrate": "tsx --env-file=../.env migrate.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.9.5",
    "better-auth": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.30.10",
    "express": "^4.18.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/ws": "^8.5.10",
    "tsx": "^4.21.0",
    "typescript": "~5.6.2"
  },
  "engines": {
    "node": ">=20.0"
  }
}
